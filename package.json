{
  "name": "patrimoine",
  "version": "0.1.0-beta.1",
  "description": "Sovereign, SAP-native personal financial wealth and management application.",
  "keywords": [
    "sap-cap",
    "svelte5",
    "personal-finance",
    "wealth-management",
    "sovereignty",
    "gdpr-by-design",
    "fiori-design"
  ],
  "author": "Patrimoine Contributors",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maki-Grz/patrimoine.git"
  },
  "bugs": {
    "url": "https://github.com/Maki-Grz/patrimoine/issues"
  },
  "homepage": "https://github.com/Maki-Grz/patrimoine#readme",
  "dependencies": {
    "@sap/cds": "^10.0.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.0.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "node --test test/patrimoine-service.test.js",
    "build:frontend": "npm run build --prefix app",
    "build:backend": "cds build --production",
    "build": "npm run build:frontend && npm run build:backend",
    "db:deploy": "cds deploy --to sqlite:db.sqlite",
    "db:clean": "node srv/clean-db.js",
    "db:seed": "node srv/seed-demo.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sql",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "[production]": {
          "kind": "xsuaa"
        }
      }
    },
    "folders": {
      "app": "app/dist"
    }
  }
}
